# Backend environment variables (backend/config.py loads these; the real .env
# lives here at the repo root, gitignored). In production (Railway) set them as
# service variables instead — there is no .env file in the Docker image.
# The frontend has its own list: frontend/.env.example.

# --- Required ---

# Postgres connection string. The database MUST have the pgvector extension
# available (document_chunks.embedding is a vector(1536) column; migrations run
# CREATE EXTENSION IF NOT EXISTS vector). Local dev: docker-compose.yml already
# uses the pgvector image. Railway: Railway's default Postgres service does NOT
# ship pgvector — deploy Postgres from Railway's "pgvector" template instead,
# then set this to a reference to it, e.g. ${{pgvector.DATABASE_URL}}.
DATABASE_URL=postgresql://oracle:oracle123@localhost:5434/oracle

# Signs the login JWTs. Use a fresh random value per environment (never reuse
# the dev one in production):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Read implicitly by langchain-openai (ChatOpenAI / OpenAIEmbeddings) — used by
# every agent plus embeddings. The pipeline uses gpt-4o (verification agent)
# and gpt-4o-mini, so the key's project needs access to both.
OPENAI_API_KEY=

# Web source discovery (retrieval/search.py). Without it, discovery of
# non-upload sources fails.
TAVILY_API_KEY=

# --- CORS (browser origins allowed to call this API) ---

# Comma-separated, no trailing slash. Defaults to http://localhost:3000, so
# local dev needs nothing. In production set this to the real frontend origin,
# e.g. https://oracle.vercel.app  (replaces the default — add localhost back
# explicitly if you still want it).
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: regex for origins that can't be listed up front, e.g. Vercel
# preview deployments. Keep it project-specific — a bare .*\.vercel\.app would
# let every Vercel site call this API from a browser.
# CORS_ALLOW_ORIGIN_REGEX=https://your-app-.*-your-team\.vercel\.app

# --- Not currently used ---

# config.py reads this and warns when unset, but no code path calls Anthropic
# yet (langchain-anthropic is installed, unused). Safe to leave empty.
ANTHROPIC_API_KEY=

# --- Set by the platform, not by you ---

# Railway injects PORT; the Dockerfile's start command binds to it (falls back
# to 8000 locally). Don't set it manually on Railway.
