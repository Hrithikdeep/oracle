# Frontend environment variables. Copy to .env.local for local dev; on Vercel,
# set these in Project Settings -> Environment Variables. Backend vars are
# listed separately in the repo-root .env.example.

# --- Required (the only one) ---

# Public base URL of the deployed backend API — no trailing slash needed
# (stripped if present), and it must be https:// in production, since the
# Vercel-hosted page is https and browsers block mixed-content requests.
#   Local dev:  http://localhost:8000
#   Production: https://your-backend.up.railway.app
#
# This is a NEXT_PUBLIC_ variable, so it is inlined into the client bundle at
# BUILD time (changing it on Vercel needs a redeploy) and is visible to anyone
# who opens devtools — never put a secret in it. Production builds fail fast if
# it is unset (see next.config.ts) instead of shipping a localhost fallback.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
